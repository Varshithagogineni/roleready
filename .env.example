# ── Backend secrets (copy to .env and fill in) ──────────────────────────────
# .env is gitignored — never commit real keys.

# Tavily (web research) — https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — Project Settings → API. Use the SERVICE ROLE key (server-side only).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJ...service_role...

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash-lite
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# ── MCP server (remote / deployed) ──────────────────────────────────────────
# Leave MCP_REQUIRE_AUTH unset for local stdio use (keys then come from this
# .env). Set it in production so every caller must present the personal
# connection code they generated in the RoleReady web app.
MCP_REQUIRE_AUTH=true

# service_role key. A caller has no Supabase session of their own, so RLS has
# nothing to act on; the code -> user -> keys hop runs through
# keys_for_mcp_token(), which only service_role may execute.
# Server-side only — never ship this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
