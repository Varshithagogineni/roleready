# ── Backend secrets (copy to .env and fill in) ──────────────────────────────
# .env is gitignored — never commit real keys.

# Tavily (web research) — https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — Project Settings → API. Use the SERVICE ROLE key (server-side only).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJ...service_role...

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash-lite
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# ── MCP server (remote / deployed) ──────────────────────────────────────────
# Leave MCP_REQUIRE_AUTH unset for local stdio use; set it in production so the
# deployed MCP server only answers callers who have signed in with Google.
MCP_REQUIRE_AUTH=true
# Host root of the deployment — do NOT append /mcp.
MCP_BASE_URL=https://your-deployment.vercel.app

# Google OAuth app (the SAME one Supabase uses for Google sign-in is fine).
# Its "Authorised redirect URIs" must include:
#     <MCP_BASE_URL>/auth/callback
# MCP clients cannot self-register with Supabase Auth (no dynamic client
# registration), so FastMCP proxies OAuth to Google instead.
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=

# service_role key — the MCP server resolves a Google email to that user's saved
# API keys via the api_keys_for_email() function, which only service_role may
# execute. Server-side only; never ship this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
